# deploy.sh tạo deploy/.env từ file này. KHÔNG commit deploy/.env.
# Chỉ cần điền các dòng đánh dấu (*). Dòng để trống còn lại deploy.sh tự sinh.

# --- Domain -------------------------------------------------------------------
# Để trống → dùng <ip-vps>.sslip.io (HTTPS miễn phí, không cần mua domain).
# Có domain riêng thì trỏ bản ghi A về IP VPS rồi điền vào đây, ví dụ: demo.tenban.vn
DOMAIN=

# --- Email: Brevo free (300 email/ngày) — Brevo > SMTP & API > SMTP -----------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# (*) "Login" trong trang SMTP của Brevo
SMTP_USER=
# (*) SMTP key của Brevo
SMTP_PASSWORD=
# (*) email người gửi đã xác minh trong Brevo
MAIL_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
EMAIL_PROVIDER=smtp

# --- Video: LiveKit Cloud free — cloud.livekit.io > Settings > Keys -----------
# (*) dạng wss://<project>.livekit.cloud
LIVEKIT_URL=
# (*)
LIVEKIT_API_KEY=
# (*)
LIVEKIT_API_SECRET=
VIDEO_PROVIDER=livekit

# --- Sao lưu: Cloudflare R2 (miễn phí 10 GB) — R2 > Manage API tokens ---------
# (*) https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# (*) bucket riêng cho backup, ví dụ english-backup
R2_BUCKET=
# (*) token quyền Object Read & Write cho bucket trên
R2_ACCESS_KEY_ID=
# (*)
R2_SECRET_ACCESS_KEY=
BACKUP_KEEP=7

# --- Tự sinh lần chạy đầu (để trống) -----------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
DB_USER=app

# --- Khác ---------------------------------------------------------------------
POLICY_VERSION=2026-11
# Dữ liệu mẫu cho demo: bỏ dấu # ở lần chạy đầu. Tài khoản mẫu dùng mật khẩu công khai
# Demo@1234 → đổi mật khẩu ngay sau khi seed nếu link demo được phát ra ngoài (R18).
#SPRING_PROFILES_ACTIVE=demo-seed
