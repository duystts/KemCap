# Sao chép thành deploy/.env trên server. KHÔNG commit giá trị thật.

# Database
DB_URL=jdbc:postgresql://postgres:5432/english
DB_USER=app
DB_PASSWORD=
POSTGRES_PASSWORD=

# Security — ít nhất 32 ký tự ngẫu nhiên (openssl rand -base64 48)
JWT_SECRET=

# Frontend (CORS + link trong email)
FRONTEND_URL=https://app.example.com

# Email (Brevo / Gmail SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=

# Video (LiveKit Cloud)
VIDEO_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Privacy
POLICY_VERSION=2026-11

# Caddy
DOMAIN=api.example.com
